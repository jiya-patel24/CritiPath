#include <iostream.h>
#include <string.h>
#include <conio.h>
#include <time.h>
#include <fstream.h>
#include <stdio.h>      // only needed for remove() in the demo

// ================== NODE ==================
class Node
{
public:
    int id;
    char label[50];

    Node()
    {
        id = -1;
        label[0] = '\0';
    }

    Node(int nodeId, char nodeLabel[])
    {
        id = nodeId;
        strcpy(label, nodeLabel);
    }
};

// ================== EDGE ==================
class Edge
{
public:
    int fromId;
    int toId;
    float cost;
    int directed;   // 0 = two-way, 1 = one-way

    Edge()
    {
        fromId = -1;
        toId = -1;
        cost = 0;
        directed = 0;
    }

    Edge(int from, int to, float edgeCost, int isDirected)
    {
        fromId = from;
        toId = to;
        cost = edgeCost;
        directed = isDirected;
    }
};

// ================== GRAPH ==================
class Graph
{
private:
    Node* nodes;
    int nodeCount;
    int nodeCapacity;

    Edge* edges;
    int edgeCount;
    int edgeCapacity;

    void growNodeArray()
    {
        int newCapacity = nodeCapacity * 2;
        Node* newArray = new Node[newCapacity];
        int i;
        for (i = 0; i < nodeCount; i++)
            newArray[i] = nodes[i];
        delete[] nodes;
        nodes = newArray;
        nodeCapacity = newCapacity;
    }

    void growEdgeArray()
    {
        int newCapacity = edgeCapacity * 2;
        Edge* newArray = new Edge[newCapacity];
        int i;
        for (i = 0; i < edgeCount; i++)
            newArray[i] = edges[i];
        delete[] edges;
        edges = newArray;
        edgeCapacity = newCapacity;
    }

    void removeEdgesForNode(int id)
    {
        int i = 0;
        int j;

        while (i < edgeCount)
        {
            if (edges[i].fromId == id || edges[i].toId == id)
            {
                for (j = i; j < edgeCount - 1; j++)
                    edges[j] = edges[j + 1];
                edgeCount--;
            }
            else
            {
                i++;
            }
        }
    }

public:
    Graph()
    {
        nodeCapacity = 4;
        nodes = new Node[nodeCapacity];
        nodeCount = 0;

        edgeCapacity = 4;
        edges = new Edge[edgeCapacity];
        edgeCount = 0;
    }

    ~Graph()
    {
        delete[] nodes;
        delete[] edges;
    }

    void addNode(int id, char label[])
    {
        if (nodeCount == nodeCapacity)
            growNodeArray();
        nodes[nodeCount] = Node(id, label);
        nodeCount++;
    }

    void addEdge(int fromId, int toId, float cost, int directed)
    {
        if (edgeCount == edgeCapacity)
            growEdgeArray();
        edges[edgeCount] = Edge(fromId, toId, cost, directed);
        edgeCount++;
    }

    void removeNode(int id)
    {
        int i;
        int index = -1;

        for (i = 0; i < nodeCount; i++)
        {
            if (nodes[i].id == id)
            {
                index = i;
                break;
            }
        }

        if (index == -1)
        {
            cout << "removeNode: node " << id << " not found\n";
            return;
        }

        for (i = index; i < nodeCount - 1; i++)
            nodes[i] = nodes[i + 1];

        nodeCount--;

        removeEdgesForNode(id);
    }

    void removeEdge(int fromId, int toId)
    {
        int i;
        int j;
        int matches;

        for (i = 0; i < edgeCount; i++)
        {
            matches = 0;

            if (edges[i].directed == 1)
            {
                if (edges[i].fromId == fromId && edges[i].toId == toId)
                    matches = 1;
            }
            else
            {
                if ((edges[i].fromId == fromId && edges[i].toId == toId) ||
                    (edges[i].fromId == toId && edges[i].toId == fromId))
                    matches = 1;
            }

            if (matches == 1)
            {
                for (j = i; j < edgeCount - 1; j++)
                    edges[j] = edges[j + 1];
                edgeCount--;
                return;
            }
        }

        cout << "removeEdge: edge " << fromId << " -> " << toId << " not found\n";
    }

    void printGraph()
    {
        int i;

        cout << "----- NODES -----\n";
        for (i = 0; i < nodeCount; i++)
            cout << nodes[i].id << ": " << nodes[i].label << "\n";

        cout << "----- EDGES -----\n";
        for (i = 0; i < edgeCount; i++)
        {
            cout << edges[i].fromId << " -> " << edges[i].toId
                 << " (cost=" << edges[i].cost
                 << ", directed=" << edges[i].directed << ")\n";
        }
    }

    // ---- METHODS NEEDED FOR PATHFINDING ----

    int getNumNodes()
    {
        return nodeCount;
    }

    float getWeight(int fromId, int toId)
    {
        int i;
        for (i = 0; i < edgeCount; i++)
        {
            if (edges[i].directed == 1)
            {
                if (edges[i].fromId == fromId && edges[i].toId == toId)
                    return edges[i].cost;
            }
            else
            {
                if ((edges[i].fromId == fromId && edges[i].toId == toId) ||
                    (edges[i].fromId == toId && edges[i].toId == fromId))
                    return edges[i].cost;
            }
        }
        return -1;   // no edge found
    }

    // ---- READ-ONLY GETTERS (for save/load) ----
    int getNodeCount()          { return nodeCount; }
    int getEdgeCount()          { return edgeCount; }
    Node getNodeAt(int index)   { return nodes[index]; }
    Edge getEdgeAt(int index)   { return edges[index]; }
};

// ================== PATHFINDING STRATEGY (ABSTRACT BASE) ==================
const int MAX_NODES = 20;

class PathfindingStrategy
{
    public:
        virtual int findPath(Graph &g, int source, int destination,
                              int outPath[], int &outPathLength) = 0;
        virtual ~PathfindingStrategy() {}
};

// ================== BFS STRATEGY ==================
class BFSStrategy : public PathfindingStrategy
{
    public:
        int findPath(Graph &g, int source, int destination,
                      int outPath[], int &outPathLength)
        {
            int n = g.getNumNodes();
            int visited[MAX_NODES];
            int parent[MAX_NODES];

            int i;
            for (i = 0; i < n; i++)
            {
                visited[i] = 0;
                parent[i] = -1;
            }

            int queueArr[MAX_NODES];
            int front = 0, rear = 0;

            queueArr[rear++] = source;
            visited[source] = 1;

            while (front < rear)
            {
                int current = queueArr[front++];
                if (current == destination)
                    break;

                int neighbor;
                for (neighbor = 0; neighbor < n; neighbor++)
                {
                    if (g.getWeight(current, neighbor) != -1 && !visited[neighbor])
                    {
                        visited[neighbor] = 1;
                        parent[neighbor] = current;
                        queueArr[rear++] = neighbor;
                    }
                }
            }

            if (!visited[destination])
            {
                outPathLength = 0;
                return -1;
            }

            int temp[MAX_NODES];
            int count = 0;
            int node = destination;
            while (node != -1)
            {
                temp[count++] = node;
                node = parent[node];
            }

            outPathLength = count;
            for (i = 0; i < count; i++)
                outPath[i] = temp[count - 1 - i];

            return count - 1;
        }
};

// ================== DIJKSTRA STRATEGY ==================
class DijkstraStrategy : public PathfindingStrategy
{
    public:
        int findPath(Graph &g, int source, int destination,
                      int outPath[], int &outPathLength)
        {
            int n = g.getNumNodes();
            int dist[MAX_NODES];
            int visited[MAX_NODES];
            int parent[MAX_NODES];

            int i;
            for (i = 0; i < n; i++)
            {
                dist[i] = 9999;      // "infinity" sentinel
                visited[i] = 0;
                parent[i] = -1;
            }
            dist[source] = 0;

            int count;
            for (count = 0; count < n - 1; count++)
            {
                // find closest unvisited node
                int u = -1, minDist = 9999;
                for (i = 0; i < n; i++)
                {
                    if (!visited[i] && dist[i] < minDist)
                    {
                        minDist = dist[i];
                        u = i;
                    }
                }

                if (u == -1)
                    break;   // remaining nodes unreachable

                visited[u] = 1;

                // relax neighbors of u
                int v;
                for (v = 0; v < n; v++)
                {
                    float weight = g.getWeight(u, v);
                    if (weight != -1 && !visited[v] && dist[u] + weight < dist[v])
                    {
                        dist[v] = dist[u] + (int)weight;
                        parent[v] = u;
                    }
                }
            }

            if (dist[destination] == 9999)
            {
                outPathLength = 0;
                return -1;
            }

            int temp[MAX_NODES];
            int cnt = 0;
            int node = destination;
            while (node != -1)
            {
                temp[cnt++] = node;
                node = parent[node];
            }

            outPathLength = cnt;
            for (i = 0; i < cnt; i++)
                outPath[i] = temp[cnt - 1 - i];

            return dist[destination];
        }
};

// ================== TIMER ==================
class Timer
{
private:
    clock_t startTime;
    clock_t endTime;

public:
    void start()
    {
        startTime = clock();
    }

    void stop()
    {
        endTime = clock();
    }

    float getElapsedSeconds()
    {
        return (float)(endTime - startTime) / CLOCKS_PER_SEC;
    }
};

// ================== LOGGER (file handling) ==================
// Appends "<timestamp> - <message>" as a new line in LOG.TXT.
// Returns 0 on success, -1 if the file could not be opened.
int logEvent(char message[])
{
    ofstream logFile;
    logFile.open("LOG.TXT", ios::app);

    if (!logFile)
    {
        cout << "Could not open log file\n";
        return -1;
    }

    time_t now = time(0);
    char* timeString = ctime(&now);

    // ctime() ends with its own '\n'. Overwrite it with '\0'
    // so the timestamp and message stay on one line.
    int i = 0;
    while (timeString[i] != '\0')
    {
        if (timeString[i] == '\n')
            timeString[i] = '\0';
        i++;
    }

    logFile << timeString << " - " << message << "\n";

    logFile.close();
    return 0;
}

// ---------- TASK 1: NEAREST TARGET (fewest steps) ----------
// Returns node id of nearest target, or -1 if none reachable.
// A start node that is itself a target returns itself.
int findNearestTarget(Graph &g, int startNode, int isTarget[])
{
    int n = g.getNumNodes();
    if (n > MAX_NODES) n = MAX_NODES;
    if (startNode < 0 || startNode >= n)
        return -1;

    int visited[MAX_NODES];
    int queueArr[MAX_NODES];
    int front = 0, rear = 0;
    int i, current, neighbor;

    for (i = 0; i < MAX_NODES; i++)
        visited[i] = 0;

    queueArr[rear++] = startNode;
    visited[startNode] = 1;

    while (front < rear)
    {
        current = queueArr[front++];

        if (isTarget[current] == 1)      // first target found = nearest
            return current;

        for (neighbor = 0; neighbor < n; neighbor++)
        {
            if (g.getWeight(current, neighbor) != -1 && !visited[neighbor])
            {
                visited[neighbor] = 1;
                queueArr[rear++] = neighbor;
            }
        }
    }
    return -1;                           // no target reachable
}

// ---------- TASK 2: BLOCKAGE + REROUTE ----------
void printPathLine(int path[], int len)
{
    int i;
    if (len == 0)
    {
        cout << "No path found\n";
        return;
    }
    for (i = 0; i < len; i++)
        cout << path[i] << " ";
    cout << "\n";
}

// NOTE: the blocked edge stays removed afterwards (removeEdge is permanent).
void simulateBlockage(Graph &g, int startNode, int endNode,
                      int blockedFrom, int blockedTo)
{
    int n = g.getNumNodes();
    if (startNode < 0 || startNode >= n || endNode < 0 || endNode >= n)
    {
        cout << "simulateBlockage: invalid start or end node\n";
        return;
    }

    BFSStrategy bfs;                     // existing strategy, unchanged
    int path[MAX_NODES];
    int len;

    bfs.findPath(g, startNode, endNode, path, len);
    cout << "Path before blockage: ";
    printPathLine(path, len);

    cout << "Blocking edge " << blockedFrom << " - " << blockedTo << "\n";
    g.removeEdge(blockedFrom, blockedTo);

    bfs.findPath(g, startNode, endNode, path, len);
    cout << "Path after blockage:  ";
    printPathLine(path, len);
}

// ---------- TASK 3: ISOLATION IMPACT ----------
// Counts nodes reachable from start, pretending skipNode does not exist.
// Pass skipNode = -1 to skip nothing.
int countReachable(Graph &g, int start, int skipNode)
{
    int n = g.getNumNodes();
    if (n > MAX_NODES) n = MAX_NODES;
    if (start == skipNode || start < 0 || start >= n)
        return 0;

    int visited[MAX_NODES];
    int queueArr[MAX_NODES];
    int front = 0, rear = 0;
    int count = 0;
    int i, current, neighbor;

    for (i = 0; i < MAX_NODES; i++)
        visited[i] = 0;

    queueArr[rear++] = start;
    visited[start] = 1;

    while (front < rear)
    {
        current = queueArr[front++];
        count++;
        for (neighbor = 0; neighbor < n; neighbor++)
        {
            if (neighbor != skipNode && !visited[neighbor] &&
                g.getWeight(current, neighbor) != -1)
            {
                visited[neighbor] = 1;
                queueArr[rear++] = neighbor;
            }
        }
    }
    return count;
}

// Returns how many OTHER nodes get cut off from referenceStartNode
// if nodeToRemove disappears. Returns -1 on invalid input.
// Graph is NOT modified.
int isolationImpact(Graph &g, int nodeToRemove, int referenceStartNode)
{
    int n = g.getNumNodes();
    if (nodeToRemove < 0 || nodeToRemove >= n ||
        referenceStartNode < 0 || referenceStartNode >= n ||
        nodeToRemove == referenceStartNode)
        return -1;

    int before = countReachable(g, referenceStartNode, -1);
    int after  = countReachable(g, referenceStartNode, nodeToRemove);

    // extra -1: the removed node itself is not "cut off", it is gone
    return before - after - 1;
}

// ---------- TASK 4: SAVE / LOAD ----------
// File format:  NODE <id> <label>     EDGE <from> <to> <cost> <directed>
// Limitation: labels must not contain spaces or be empty.
int saveGraphToFile(Graph &g, char filename[])
{
    ofstream f(filename);
    if (!f)
        return -1;

    int i;
    for (i = 0; i < g.getNodeCount(); i++)
    {
        Node nd = g.getNodeAt(i);
        f << "NODE " << nd.id << " " << nd.label << "\n";
    }
    for (i = 0; i < g.getEdgeCount(); i++)
    {
        Edge e = g.getEdgeAt(i);
        f << "EDGE " << e.fromId << " " << e.toId << " "
          << e.cost << " " << e.directed << "\n";
    }

    if (!f)
        return -1;
    return 0;
}

// Loads INTO g, so pass a new empty Graph (existing content is kept).
int loadGraphFromFile(Graph &g, char filename[])
{
    ifstream f(filename);
    if (!f)
        return -1;

    char tag[10];
    char label[50];
    int id, from, to, directed;
    float cost;

    while (f >> tag)
    {
        if (strcmp(tag, "NODE") == 0)
        {
            f >> id;
            f.width(50);
            f >> label;
            if (!f) return -1;
            g.addNode(id, label);
        }
        else if (strcmp(tag, "EDGE") == 0)
        {
            f >> from >> to >> cost >> directed;
            if (!f) return -1;
            g.addEdge(from, to, cost, directed);
        }
        else
            return -1;                   // unknown line = bad file
    }
    return 0;
}

// =====================================================================
// ================== DEMO (console presentation) ======================
// Everything below is presentation only. The engine above never
// prints diagrams or uses any application words.
// =====================================================================

void banner(char title[])
{
    cout << "============================================================\n";
    cout << "  " << title << "\n";
    cout << "============================================================\n\n";
}

void nextScreen()
{
    cout << "\n   [ press any key to continue ]";
    getch();
    clrscr();
}

// Prints a text file line by line, indented, so we can SHOW what was saved.
void showFile(char filename[])
{
    ifstream f(filename);
    char line[100];

    if (!f)
    {
        cout << "   (could not open " << filename << ")\n";
        return;
    }
    while (f.getline(line, 100))
        cout << "   | " << line << "\n";
}

// Takes the ABSTRACT base class by reference: works for any algorithm.
void showPath(PathfindingStrategy &s, char name[], Graph &g, int from, int to)
{
    int path[MAX_NODES];
    int len;
    int result = s.findPath(g, from, to, path, len);

    cout << "   " << name << " -> result = " << result << "   path: ";
    printPathLine(path, len);
}

